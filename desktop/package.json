{
  "name": "talksketch-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "AI meeting notes for your desktop",
  "author": "TalkSketch",
  "license": "Apache-2.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "dir": "electron-builder --win --dir",
    "publish:download": "node scripts/publish-download.mjs"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "work.talksketch.desktop",
    "productName": "TalkSketch",
    "copyright": "Copyright © 2026 TalkSketch",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "panel-dist/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "signtoolOptions": {
        "publisherName": "TalkSketch"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "TalkSketch",
      "guid": "647aea2a-77c5-5119-9e35-4e7dcbf79a20",
      "artifactName": "TalkSketch-Setup-${version}.${ext}",
      "differentialPackage": true
    },
    "portable": {
      "artifactName": "TalkSketch-Portable-${version}.${ext}"
    },
    "afterPack": "./scripts/after-pack.js",
    "afterAllArtifactBuild": "./scripts/after-all-artifact-build.js",
    "publish": [
      {
        "provider": "generic",
        "url": "https://api.talksketch.work/download/",
        "channel": "latest"
      }
    ],
    "electronDist": "node_modules/electron/dist"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
