# Copy to .env and fill in. Never commit real keys.

# ---- Model (required) ------------------------------------------------------
# Any OpenAI-compatible endpoint that supports JSON output.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash

# ---- Server ----------------------------------------------------------------
DEMO_PORT=8788
# Public HTTPS origin; used for the OAuth redirect and PayPal return links.
PUBLIC_BASE_URL=https://your-domain.example
DATA_DIR=./data
LOG_LEVEL=info

# ---- Google sign-in (optional) --------------------------------------------
# Web OAuth client. Authorized redirect URI:
#   ${PUBLIC_BASE_URL}/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Long random string that signs 12-hour session tokens.
SESSION_SECRET=
# Comma-separated pilot emails: unlimited access, no trial.
ALLOWED_EMAILS=

# ---- Trials and access keys -----------------------------------------------
TRIAL_DAYS=3
# Comma-separated keys for the API when Google sign-in is not used.
# These unlock paid endpoints; the public demo code does not.
ACCESS_KEYS=
DEMO_CODE=TALKSKETCH

# ---- Billing (PayPal) ------------------------------------------------------
# PayPal plans are immutable; create a new plan to change the price.
PAYPAL_PLAN_ID=P-0ET25800HC594571SNL3ONGY
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.paypal.com

# ---- Speech-to-text (required for audio capture) --------------------------
# xai    = POST /stt, auto-detects language, returns { text, language }
# openai = POST /audio/transcriptions (whisper-1)
STT_PROVIDER=xai
STT_API_KEY=
STT_BASE_URL=https://api.x.ai/v1
STT_MODEL=xai-stt

# ---- Legacy bot mode (optional) -------------------------------------------
# Only used by src/index.ts / src/live.ts, not by the desktop app.
MEETING_PLATFORM=google_meet
MEETING_ID=
MEETING_TOPIC=
MEETING_PARTICIPANTS=
COMPANY_CONTEXT=
BOT_NAME=Scribe
TRANSCRIPT_SOURCE=mock
VEXA_BASE_URL=http://localhost:18056
VEXA_API_KEY=
POLL_INTERVAL_MS=2000
END_AFTER_SILENCE_MS=180000
MOCK_SPEED=3
RUN_INTERVAL_MS=20000
MAX_TURNS=6
EXPRESS_SERVER_URL=http://127.0.0.1:3000
NOTE_MIN_INTERVAL_MS=60000
SUGGESTION_MIN_INTERVAL_MS=120000
MAX_SUGGESTIONS=3
NOTE_WARMUP_MS=45000
SUGGESTION_MIN_MEETING_MS=120000
CONTEXT_MAX_TOKENS=2000
