{
  "name": "meeting-partner",
  "version": "0.2.0",
  "private": true,
  "description": "Self-hostable backend for TalkSketch: Google sign-in, trials, PayPal, stateless AI",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/index.js",
    "canvas": "mcp-excalidraw-server start",
    "canvas:status": "mcp-excalidraw-server status",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "board:check": "tsx src/check-board.ts",
    "canvas:stop": "mcp-excalidraw-server stop",
    "demo": "node dist/web.js"
  },
  "dependencies": {
    "@openai/agents": "^0.22.0",
    "dotenv": "^18.0.10",
    "google-auth-library": "^11.3.4",
    "mcp-excalidraw-server": "^2.2.0",
    "openai": "^7.56.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
